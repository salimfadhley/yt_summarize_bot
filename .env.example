# ====== REQUIRED CONFIGURATION ======
# Get these from Telegram:

# 1. Bot Token from @BotFather
#    - Open https://t.me/botfather
#    - Send /newbot and follow instructions
#    - Copy the token (format: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Your Telegram User ID (for admin commands)
#    - Open https://t.me/userinfobot
#    - It will show your user ID
#    - Copy the number (format: 123456789)
AUTH_USER_ID=your_telegram_user_id_here

# ====== OPTIONAL CONFIGURATION ======

# AI Configuration (uses free Pollinations AI if not provided)
# For Google Gemini: https://aistudio.google.com/apikey
# For OpenAI-compatible: Use your provider's API key
AI_API_KEY=
AI_MODEL_NAME=gemini-2.0-flash
AI_API_URL=https://text.pollinations.ai/openai

# Redis Configuration (uses in-memory storage if not provided)
# When using Docker Compose, keep REDIS_HOST=redis
# For external Redis: Use your Redis host URL
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=